# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 저장소에 커밋하지 않는다.

# Airflow 컨테이너 실행 UID (Linux/WSL에서는 `id -u` 결과를 사용)
AIRFLOW_UID=50000

# Airflow 웹서버 세션 서명 키 (임의의 긴 난수 문자열)
AIRFLOW_WEBSERVER_SECRET_KEY=

# Airflow 관리자 계정
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

# AWS 자격 증명 (Kinesis / S3 / Glue / Athena 접근용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2
